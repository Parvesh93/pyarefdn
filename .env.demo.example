# Copy these values into .env on a SEPARATE demo installation.
# Do not deploy the demo over pyarefoundation.org.
# Never connect the demo to the live database or production payment credentials.
APP_NAME="Pyare Foundation Demo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://demo.example.org
DEMO_MODE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Kolkata

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pyare_demo_only
DB_USERNAME=pyare_demo_user
DB_PASSWORD=REPLACE_WITH_NEW_DEMO_ONLY_PASSWORD

SESSION_DRIVER=file
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="demo@example.org"
MAIL_FROM_NAME="Pyare Foundation Demo"

LOG_CHANNEL=stack
LOG_LEVEL=warning
